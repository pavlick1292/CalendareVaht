<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="#DD1E1E1E">

    <!-- Центральный блок для цифры и подписи -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widgetToWork"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetLabelToWork"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="до вахты"
            android:textColor="#B0FFFFFF"
            android:textSize="14sp" />

        <!-- Скрытые элементы для совместимости с кодом (мы их просто не будем использовать) -->
        <TextView
            android:id="@+id/widgetToHome"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <TextView
            android:id="@+id/widgetLabelToHome"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Кнопки внизу -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widgetRefresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="2dp"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="Обновить" />

        <ImageView
            android:id="@+id/widgetTheme"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:padding="2dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Тема" />
    </LinearLayout>
</LinearLayout>